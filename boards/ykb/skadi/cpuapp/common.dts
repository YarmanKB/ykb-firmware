#include "pinctrl.dtsi"

#include "backlight.dts"
#include "battsense.dts"
#include "kb-handler.dts"

/ {

	gpio_fwd: nrf-gpio-forwarder {
		compatible = "nordic,nrf-gpio-forwarder";
		status = "okay";

		cpunet_uart {
			gpios = <&gpio1 14 0>, <&gpio1 15 0>;
		};
	};

	zephyr,user {
		ykb-power-button = <&button0>;
		ykb-power-indicator = <&led1>;
		ykb-power-shutdown-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		mcuboot-button0 = &button0;
		mcuboot-led0 = &led0;
	};

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
		zephyr,bt-mon-uart = &uart0;
		zephyr,bt-c2h-uart = &uart0;

		zephyr,bt-hci = &bt_hci_ipc0;
	};
	buttons {
		compatible = "gpio-keys";
		button0: button0 {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
			label = "Power / Recovery button";
		};
	};

	// We are using the same LED as PWM in the firmware itself
	// and as GPIO LED in MCUBoot (MCUBoot doesn't support pwm-leds for some reason)
	pwm-leds {
		compatible = "pwm-leds";
		led1: led1 {
			pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "Power LED";
		};
	};
	gpio-leds {
		compatible = "gpio-leds";
		led0: led0 {
			gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
			label = "Recovery LED";
		};
	};

};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";

	cdc_acm_uart0 {
		current-speed = <115200>;
		compatible = "zephyr,cdc-acm-uart";
		label = "Zephyr USB CDC-ACM";
	};

	hid_kbd: hid_kbd {
		compatible = "zephyr,hid-device";
		label = "hid_kbd";
		protocol-code = "keyboard";
		in-report-size = <8>;
		out-report-size = <1>;
		in-polling-period-us = <1000>;
		out-polling-period-us = <1000>;
	};

	hid_mouse: hid_mouse {
		compatible = "zephyr,hid-device";
		label = "hid_mouse";
		protocol-code = "mouse";
		in-report-size = <8>;
		out-report-size = <1>;
		in-polling-period-us = <1000>;
		out-polling-period-us = <1000>;
	};

	hid_vendor: hid_vendor {
		compatible = "zephyr,hid-device";
		label = "hid_vendor";
		protocol-code = "none";
		in-report-size = <64>;
		out-report-size = <64>;
		in-polling-period-us = <1000>;
		out-polling-period-us = <1000>;
	};
};

&vregmain {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&vregradio {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&vregh {
	status = "okay";
};

&lfxo {
	load-capacitors = "external";
};

&uicr {
	nfct-pins-as-gpios;
};

&adc {
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time =
			<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <10>;
		zephyr,oversampling = <3>;
	};
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time =
			<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <10>;
		zephyr,oversampling = <3>;
	};
	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time =
			<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN2>;
		zephyr,resolution = <10>;
		zephyr,oversampling = <3>;
	};
	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time =
			<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN3>;
		zephyr,resolution = <10>;
		zephyr,oversampling = <3>;
	};

};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c1 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x00014000>;
		};

		slot0_partition: partition@14000 {
			label = "image-0";
			reg = <0x00014000 0x0004E000>;
		};

		slot1_partition: partition@62000 {
			label = "image-1";
			reg = <0x00062000 0x0004E000>;
		};

		netcore_slot_partition: partition@b0000 {
			label = "image-net-core";
			reg = <0x000B0000 0x00040000>;
		};

		storage_partition: partition@f0000 {
			label = "storage";
			reg = <0x000F0000 0x00010000>;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

#include <nordic/nrf5340_sram_partition.dtsi>
#include <nordic/nrf5340_shared_sram_partition.dtsi>
