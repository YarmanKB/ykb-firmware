config YKB_BUILD_SPLIT_HALVES
  bool "Build both split halves (left/right)"
  default y

if SUPPORT_NETCORE

config SUPPORT_NETCORE_CPUNET_MPSL
	default y

config SUPPORT_NETCORE_CPUNET_ESB
    default y

config SUPPORT_NETCORE_HCI_IPC
	default y

choice NETCORE
	default NETCORE_HCI_IPC if BOARD_SKADI_NRF5340_CPUAPP_LEFT || BOARD_SKADI_NRF5340_CPUAPP_RIGHT
endchoice

endif # SUPPORT_NETCORE
