menuconfig KB_HANDLER
    bool "Enable KB Handler subsystem"
    select KSCAN

if KB_HANDLER

    choice KB_HANDLER_IMPL
        prompt "KB Handler implementation"

        config KB_HANDLER_SPLITLINK_MASTER
            bool "Splitlink (master)"
            select SPLITLINK
            select SPLITLINK_SYNC
            select SPLITLINK_SYNC_MASTER

        config KB_HANDLER_SPLITLINK_SLAVE
            bool "Splitlink (slave)"
            select SPLITLINK
            select SPLITLINK_SYNC
            select SPLITLINK_SYNC_SLAVE

        config KB_HANDLER_SIMPLE
            bool "Simple"

    endchoice # KB_HANDLER_IMPL

    module = KB_HANDLER
    module-str = kb_handler
    source "subsys/logging/Kconfig.template.log_config"

    rsource "Kconfig.simple"

    config KB_HANDLER_INIT_PRIORITY
        int "Init priority"
        default APPLICATION_INIT_PRIORITY

    config KB_HANDLER_MSGQ_SIZE
        int "KB Handler message queue size"
        default 60

    config KB_HANDLER_THREAD_STACK_SIZE
        int "KB Handler thread stack size"
        default 3072

    config KB_HANDLER_THREAD_PRIORITY
        int "KB Handler thread priority"
        default 15

    config KB_HANDLER_REPORT_ROLLOVER
        bool "Enable rollover error when more than 6 keys are pressed at once"
        default y

endif
